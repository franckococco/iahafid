# Token temporal de Meta (caduca ~24h). Después conviene un token permanente de System User.
WHATSAPP_TOKEN=

# WhatsApp > API Setup > Phone number ID (no es tu celular, es el ID numérico de Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_DISPLAY_NUMBER=

# Lo inventás vos. El mismo valor lo vas a pegar en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=iahaf-verify-cambiar

# App Dashboard > Configuración de la app > Secreto de la app (firma del webhook)
WHATSAPP_APP_SECRET=

# echo = responde copiando el mensaje (para probar WhatsApp).
# openai = usa Gemini/OpenAI/Groq (API compatible con OpenAI).
AI_MODE=openai

OPENAI_API_KEY=
# Gemini (recomendado):
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.6-flash
# OpenAI:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

AI_SYSTEM_PROMPT=Sos IAHAF, vendedor de mostrador. WhatsApp, argentino informal. Máximo 2 oraciones. No inventes precios ni códigos.

# Catálogo OEM PartsLink24 (Volkswagen). No subir estas claves a GitHub.
PARTSLINK24_ENABLED=true
PARTSLINK24_COMPANY_ID=
PARTSLINK24_USER=
PARTSLINK24_PASSWORD=
PARTSLINK24_BASE_URL=https://www.partslink24.com

# Service Box (Peugeot / Citroën OEM).
SERVICEBOX_ENABLED=true
SERVICEBOX_USER=
SERVICEBOX_PASSWORD=
SERVICEBOX_BASE_URL=https://public.servicebox-parts.com

# Infobal (mayorista / stock).
INFOBAL_ENABLED=true
INFOBAL_USER=
INFOBAL_PASSWORD=
INFOBAL_BASE_URL=https://distribuidores-infobal.infobalbsa.com.ar

# Expoyer (mayorista / stock).
EXPOYER_ENABLED=true
EXPOYER_USER=
EXPOYER_PASSWORD=
EXPOYER_BASE_URL=https://expoyerweb.com.ar

# Celular del local (549…). Puede ser varios separados por coma. Tiene que ser tester en Meta.
# Si es el mismo número que escribe al bot, el aviso no se manda por WhatsApp (iría al cliente): usá /local.
OPERATOR_WHATSAPP=

# En Railway pegá estas mismas claves en Variables del servicio (no subas .env).
# Railway inyecta PORT solo.
