# Token temporal de Meta (caduca ~24h). Después conviene un token permanente de System User.
WHATSAPP_TOKEN=

# WhatsApp > API Setup > Phone number ID (no es tu celular, es el ID numérico de Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_DISPLAY_NUMBER=

# Lo inventás vos. El mismo valor lo vas a pegar en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=iahaf-verify-cambiar

# App Dashboard > Configuración de la app > Secreto de la app (firma del webhook)
WHATSAPP_APP_SECRET=

# echo = responde copiando el mensaje (para probar WhatsApp).
# openai = usa Gemini/OpenAI/Groq (API compatible con OpenAI).
AI_MODE=openai

OPENAI_API_KEY=
# Gemini (recomendado):
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.6-flash
# OpenAI:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

AI_SYSTEM_PROMPT=Sos el asistente de IAHAF. Respondé en español, de forma breve y clara, por WhatsApp.
